{
  "projects": [
    {
      "id": "letron-leos",
      "path": "../../Letron/letron-leos",
      "remote_url": "https://github.com/Link-Strategy/letron-leos",
      "status": "active",
      "description": "Automatically generated Brain Project."
    }
  ],
  "blueprint": {
    "description": "Cấu hình chuẩn để khởi tạo Brain Project Workspace từ Master",
    "ensure_dirs": [
      "assets",
      "docs",
      ".agents/rules/hands",
      ".agents/workflows/hands",
      ".agents/skills/hands",
      ".agents/templates",
      ".agents/tools/ls-engine",
      ".github",
      "components/ui",
      ".backlog"
    ],
    "sync": [
      {
        "id": "gitignore",
        "src": ".agents/templates/.gitignore",
        "dest": ".gitignore",
        "purpose": "Standard Link Strategy ignore policy."
      },
      {
        "id": "rules-brain",
        "src": ".agents/rules/brain",
        "dest": ".agents/rules",
        "activate": true,
        "purpose": "Brain-tier governance (Flattened structure)."
      },
      {
        "id": "rules-hands",
        "src": ".agents/rules/hands",
        "dest": ".agents/rules/hands",
        "purpose": "Hands-tier operational rules."
      },
      {
        "id": "workflows-brain",
        "src": ".agents/workflows/brain",
        "dest": ".agents/workflows",
        "purpose": "Brain-tier workflows."
      },
      {
        "id": "workflows-hands",
        "src": ".agents/workflows/hands",
        "dest": ".agents/workflows/hands",
        "purpose": "Hands-tier workflows."
      },
      {
        "id": "skills-brain",
        "src": ".agents/skills/brain",
        "dest": ".agents/skills",
        "purpose": "Brain-tier specialized engine capabilities."
      },
      {
        "id": "skills-hands",
        "src": ".agents/skills/hands",
        "dest": ".agents/skills/hands",
        "purpose": "Hands-tier domain-specific skills."
      },
      {
        "id": "slicing-profile",
        "src": ".agents/templates/SLICING_PROFILE_TEMPLATE.json",
        "dest": "slicing-profile.json",
        "purpose": "Sovereign DNA: Slicing Profile"
      },
      {
        "id": "tsconfig-base",
        "src": ".agents/templates/tsconfig.json",
        "dest": "tsconfig.json",
        "purpose": "Sovereign DNA: TypeScript Contract Portability"
      },
      {
        "id": "ls-brain-ci",
        "src": ".agents/templates/link-strategy-brain.yml",
        "dest": ".github/workflows/link-strategy-brain.yml",
        "purpose": "Automated Brain CI Orchestrator"
      },
      {
        "id": "constitution",
        "src": ".agents/templates/GEMINI_BRAIN_TEMPLATE.md",
        "dest": "GEMINI.md",
        "activate": true,
        "purpose": "Brain-tier project constitution."
      }
    ]
  },
  "governance": {
    "version": "2.1.0",
    "policy": "strict",
    "allowed_actions": [
      "new-project",
      "sync-dna",
      "audit-brain"
    ]
  }
}