# LINK STRATEGY ENGINE CONFIGURATION
# Copy this file to .env and adjust values as needed.

# Target GitHub Organization for new projects/satellites
LS_ORGANIZATION=Link-Strategy

# Default repository visibility (--private or --public)
LS_VISIBILITY=--private

# Default base directory for new projects (relative to master root)
LS_BASE_PATH=..

# Industrial Hardening Settings
LS_CLEANUP_ON_FAIL=true
LS_REGISTRY_BACKUP=true
